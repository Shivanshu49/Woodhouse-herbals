# Wood House Herbals — docker-compose env template.
#
# Copy to `.env` at the repo root (gitignored). docker-compose reads this
# file automatically. Override values per environment.

POSTGRES_DB=woodhouse
POSTGRES_USER=woodhouse
POSTGRES_PASSWORD=woodhouse_dev

MEILI_MASTER_KEY=woodhouse_dev_master_key_change_me
MEILI_ENV=development
