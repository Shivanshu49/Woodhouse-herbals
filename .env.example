# Wood House Herbals — root .env template for docker-compose.
#
# Copy to `.env` at the repo root (gitignored). docker-compose reads this
# file automatically when it sits next to docker-compose.yml. Override
# every value before pushing to a shared environment.

POSTGRES_USER=woodhouse
POSTGRES_PASSWORD=woodhouse_dev
POSTGRES_DB=woodhouse

# These two are convenience values read by the Backend/AI-Service when you
# point their respective .env files at the localhost-exposed services.
DATABASE_URL=postgresql://woodhouse:woodhouse_dev@localhost:5432/woodhouse
REDIS_URL=redis://localhost:6379

MEILI_MASTER_KEY=dev_master_key_change_me
MEILISEARCH_HOST=http://localhost:7700
