PORT=8001
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
LOG_LEVEL=info
# Set to true ONLY when running behind a trusted reverse proxy that sets
# X-Forwarded-For. Leave false otherwise so per-IP rate limits can't be spoofed.
TRUST_PROXY=false
