# ──────────────────────────────────────────────────────────────────
# Wood House Herbals — Backend env template
#
# Copy to `.env` and fill in real values. NEVER commit `.env` to git.
# Production secrets MUST be at least 32 random characters and must not
# match any default placeholder — the app fails to boot otherwise.
# ──────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Comma-separated list of origins permitted by CORS and reflected back to the
# browser as Access-Control-Allow-Origin. Must include the production hostname.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
# Shared parent domain for auth cookies so the storefront and admin subdomains
# both receive the session. Set in production only, e.g. .woodhouseherbals.com.
# Leave blank in dev — localhost cannot use a cookie Domain attribute.
COOKIE_DOMAIN=

# ─── Database (required) ──────────────────────────────────────────
# Restrict network access to private subnets only; never expose 5432 publicly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/woodhouse?schema=public

# ─── Redis (optional, used by BullMQ background jobs) ─────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (required) ───────────────────────────────────────────────
# Generate with: openssl rand -hex 64
# MUST be distinct across access/refresh in production.
# Rotate by deploying with the new secret then redeploying again to drop the
# old one — refresh tokens signed with the old secret will be rejected.
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME_TOO
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─── Email verification & password reset windows ──────────────────
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=3600

# ─── Login throttle / account lockout ─────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=30

# ─── Tax ──────────────────────────────────────────────────────────
# GST rate applied at checkout. Catalog prices are GST-inclusive, so this only
# governs the tax component shown on the invoice — it does not change the total
# the customer pays. Set to 0 to disable the tax split.
GST_RATE_PERCENT=18

# ─── Resend (transactional email) ─────────────────────────────────
# Without a key, reset/verify links are written to the application log
# instead of being sent — fine for development, MUST be set in production.
RESEND_API_KEY=
EMAIL_FROM=no-reply@woodhouseherbals.com

# ─── PhonePe ──────────────────────────────────────────────────────
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# ─── Meilisearch ──────────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=

# ─── Cloudflare R2 ────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=woodhouse
R2_PUBLIC_URL=https://r2.woodhouseherbals.com

# Phone OTP via MSG91 (optional in dev — OTP is echoed to the client instead)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Google sign-in (same client id as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# ── Admin panel ─────────────────────────────────────────────────
# Admin app origin — used for staff/admin password-reset links. The admin
# dev app runs on port 3001 (also listed in WEB_ORIGIN above for CORS).
ADMIN_ORIGIN=http://localhost:3001
# Staff/admin refresh-token TTL in seconds (sliding idle window).
JWT_ADMIN_REFRESH_TTL=3600
# Cloudinary signed uploads (admin media) — optional in dev; the sign
# endpoint returns 503 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
