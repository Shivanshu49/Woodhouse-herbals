{
  "name": "woodhouse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Wood House Herbals commerce API (NestJS)",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx prisma/seed-admin.ts",
    "test": "node --import tsx --test --test-reporter=spec $(find src -name '*.test.ts' ! -name '*.integration.test.ts' -type f | sort)",
    "test:integration": "node --import tsx --test --test-reporter=spec $(find src -name '*.integration.test.ts' -type f | sort)"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "google-auth-library": "^10.9.0",
    "helmet": "^7.1.0",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "prisma": "^5.18.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "tsx": "^4.16.5",
    "typescript": "^5.5.3"
  }
}
