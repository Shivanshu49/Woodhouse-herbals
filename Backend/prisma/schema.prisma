// Wood House Herbals — Prisma schema
// Source of truth for the commerce database.
//
// Conventions:
// - All money is stored in MINOR units (paise for INR) as Int.
// - Soft-deletable models carry `deletedAt DateTime?`; queries must filter
//   it via the soft-delete Prisma extension (see Backend/src/common/prisma).
// - Snapshot fields on OrderItem are immutable — they record the product
//   state at order time so future product edits/deletes do not rewrite history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
// Catalog
// ────────────────────────────────────────────────────────────────

enum ProductCategory {
  FACE_WASH
  SERUM
  CREAM
  SCRUB
  HAIR_OIL
  SHAMPOO
  COMBO
  MASK
  TONER
}

enum SkinType {
  OILY
  DRY
  COMBINATION
  SENSITIVE
  NORMAL
  ALL
}

enum ConcernType {
  SKIN
  HAIR
}

enum Currency {
  INR
}

model Concern {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  type        ConcernType
  imageUrl    String?
  accent      String?
  sortOrder   Int           @default(0)
  products    ProductConcern[]
  coupons     CouponConcern[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Category {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  category  ProductCategory
  imageUrl  String?
  sortOrder Int             @default(0)
  // Soft delete — admin "removes" by setting deletedAt; rows remain so
  // historical orders pointing at this category keep referential integrity.
  deletedAt DateTime?
  products  Product[]
  coupons   CouponCategory[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([deletedAt])
}

model Product {
  id                 String           @id @default(cuid())
  slug               String           @unique
  sku                String           @unique
  name               String
  shortDescription   String
  longDescription    String           @db.Text
  category           ProductCategory
  size               String?
  isCombo            Boolean          @default(false)
  // Money in paise (minor units).
  priceMinor         Int
  compareAtPriceMinor Int?
  currency           Currency         @default(INR)
  rating             Float            @default(0)
  reviewCount        Int              @default(0)
  inStock            Boolean          @default(true)
  stockQty           Int              @default(0)
  thumbnailUrl       String
  thumbnailAlt       String
  // Soft delete — keeps historical orders viable. Listings must filter.
  deletedAt          DateTime?
  gallery            ProductImage[]
  benefits           String[]
  howToUse           String[]
  ingredients        Ingredient[]
  badges             ProductBadge[]
  skinTypes          SkinType[]
  concerns           ProductConcern[]
  reviews            Review[]
  cartLines          CartLine[]
  orderItems         OrderItem[]
  recommendations    Recommendation[] @relation("RecForSource")
  recommendedBy      Recommendation[] @relation("RecForTarget")
  inventoryMovements InventoryMovement[]
  // Inverse side of WishlistItem.product (the customer-side rows are
  // navigated through `User.wishlistItems`).
  wishlistedBy       WishlistItem[]
  categoryRef        Category?        @relation(fields: [categoryRefId], references: [id])
  categoryRefId      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([category])
  @@index([rating])
  @@index([priceMinor])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
}

model Ingredient {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  benefit   String
  iconUrl   String?
  sortOrder Int     @default(0)
}

enum BadgeTone {
  BESTSELLER
  NEW
  SALE
  LIMITED
}

model ProductBadge {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  label     String
  tone      BadgeTone
}

model ProductConcern {
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  concern   Concern @relation(fields: [concernId], references: [id], onDelete: Cascade)
  concernId String

  @@id([productId, concernId])
}

model Recommendation {
  id             String  @id @default(cuid())
  sourceProduct  Product @relation("RecForSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  sourceProductId String
  targetProduct  Product @relation("RecForTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  targetProductId String
  score          Float   @default(0)

  @@unique([sourceProductId, targetProductId])
}

// ────────────────────────────────────────────────────────────────
// Inventory audit
// ────────────────────────────────────────────────────────────────

enum InventoryReason {
  ORDER_RESERVED
  ORDER_FULFILLED
  ORDER_CANCELLED
  // RESTOCK and STOCK_INTAKE are synonyms — kept both for back-compat
  // with code already using STOCK_INTAKE; new code should prefer RESTOCK.
  RESTOCK
  STOCK_INTAKE
  // MANUAL_ADJUSTMENT supersedes MANUAL_ADJUST; the old value remains so
  // historical rows do not require a destructive migration.
  MANUAL_ADJUSTMENT
  MANUAL_ADJUST
  RECONCILIATION
  DAMAGED
  RETURNED
  RETURN
  INITIAL_SEED
}

model InventoryMovement {
  id          String          @id @default(cuid())
  product     Product         @relation(fields: [productId], references: [id])
  productId   String
  previousQty Int
  newQty      Int
  delta       Int
  reason      InventoryReason
  // Order this movement is associated with — populated for ORDER_RESERVED,
  // ORDER_FULFILLED, ORDER_CANCELLED. Indexed for "what stock moved on order X?".
  orderId     String?
  // Optional admin/user reference — null when system-generated by order flow.
  actor       User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  // Same column as `actor` (no FK) for staff/system attribution where the
  // user record may have been deleted. New code should use `actor` /`actorId`.
  createdBy   String?
  // Free-form context — e.g. order number, stocktake id, reconciliation note.
  reference   String?
  note        String?
  createdAt   DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([reason, createdAt])
  @@index([orderId])
}

// ────────────────────────────────────────────────────────────────
// Identity / customers
// ────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id                  String     @id @default(cuid())
  // Nullable: phone-OTP accounts start with no email. Unique still enforced
  // for the rows that have one (Postgres ignores NULLs in unique indexes).
  email               String?    @unique
  // Nullable: OTP/Google accounts have no password until the user sets one.
  passwordHash        String?
  fullName            String
  phone               String?    @unique
  // Google OIDC subject — set when the account is created via / linked to
  // "Sign in with Google".
  googleId            String?    @unique
  avatarUrl           String?
  role                UserRole   @default(CUSTOMER)
  skinType            SkinType?
  primaryConcerns     String[]
  // Email verification
  emailVerified       Boolean    @default(false)
  emailVerifiedAt     DateTime?
  // Brute-force / lockout
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  // Password rotation tracking
  passwordChangedAt   DateTime?
  // Soft delete — keeps order history intact. Filter on read paths.
  deletedAt           DateTime?
  // Relations
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  reviews             Review[]
  refreshTokens       RefreshToken[]
  emailTokens         EmailVerificationToken[]
  resetTokens         PasswordResetToken[]
  authEvents          AuthEvent[]
  wishlistItems       WishlistItem[]
  inventoryActions    InventoryMovement[]
  couponRedemptions   CouponRedemption[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([deletedAt])
}

// One-time codes for phone-number sign-in. Only the SHA-256 of
// `${phone}:${code}` is stored; verification is attempt-limited so the
// 6-digit space cannot be brute-forced online.
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  // SHA-256 of the random token; the raw token only lives in the user's cookie.
  tokenHash    String    @unique
  // Family id lets us detect reuse-after-rotation and revoke the whole chain.
  familyId     String
  // When this token is rotated, we record the replacement so a replayed
  // already-rotated token can be detected and the family forcibly revoked.
  replacedById String?
  expiresAt    DateTime
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum AuthEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  REFRESH_SUCCESS
  REFRESH_REUSE_DETECTED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  PHONE_CHANGED
  ACCOUNT_LOCKED
}

model AuthEvent {
  id        String        @id @default(cuid())
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  type      AuthEventType
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([ip, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  // Optional GSTIN for business buyers; validated at the DTO layer.
  gstin     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // Now a real FK (was previously a bare string id — orphans possible).
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ────────────────────────────────────────────────────────────────
// Cart & orders
// ────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  // Guest carts identified by session id.
  sessionId String?    @unique
  lines     CartLine[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartLine {
  id             String  @id @default(cuid())
  cart           Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId         String
  product        Product @relation(fields: [productId], references: [id])
  productId      String
  quantity       Int
  unitPriceMinor Int

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  number          String        @unique
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?
  // Cart session id at checkout — used by the PhonePe success handler to
  // clear the right cart and by audit logs to correlate the buyer device.
  cartSessionId   String?
  status          OrderStatus   @default(PENDING)
  subtotalMinor   Int
  discountMinor   Int           @default(0)
  shippingMinor   Int           @default(0)
  taxMinor        Int           @default(0)
  totalMinor      Int
  currency        Currency      @default(INR)
  // Snapshot of the coupon at apply-time. We keep both the FK (for joins)
  // and a code snapshot in case the coupon is later deleted.
  appliedCoupon       Coupon? @relation(fields: [appliedCouponId], references: [id], onDelete: SetNull)
  appliedCouponId     String?
  appliedCouponCode   String?
  items           OrderItem[]
  // Shipping address snapshot at order time.
  shippingFullName String
  shippingPhone    String
  shippingLine1    String
  shippingLine2    String?
  shippingCity     String
  shippingState    String
  shippingPincode  String
  shippingCountry  String       @default("IN")
  shippingGstin    String?
  // Order idempotency key (client-provided, optional) — prevents double
  // creation on retry of the network request.
  idempotencyKey  String?       @unique
  payments        Payment[]
  shipments       Shipment[]
  redemptions     CouponRedemption[]
  placedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, placedAt])
  @@index([status, placedAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        Product @relation(fields: [productId], references: [id])
  productId      String
  // Immutable snapshots — survive product edits/deletes.
  productNameSnapshot  String
  productImageSnapshot String
  skuSnapshot          String
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int

  @@index([productId])
  @@index([orderId])
}

model Payment {
  id              String        @id @default(cuid())
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  provider        String        @default("phonepe")
  // Provider transaction id (e.g. merchantTransactionId) — globally unique
  // and used as the idempotency key on callback handling.
  providerTxnId   String?       @unique
  amountMinor     Int
  currency        Currency      @default(INR)
  status          PaymentStatus @default(INITIATED)
  rawResponse     Json?
  // Optional client-provided idempotency key on initiate. Unique per order
  // to prevent duplicate initiations from network retries.
  idempotencyKey  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([orderId, idempotencyKey])
  @@index([status, createdAt])
}

// ────────────────────────────────────────────────────────────────
// Coupons
// ────────────────────────────────────────────────────────────────

enum CouponKind {
  PERCENT
  FLAT
}

model Coupon {
  id              String           @id @default(cuid())
  code            String           @unique
  description     String?
  kind            CouponKind
  // For PERCENT: 0..100. For FLAT: amount in minor units.
  value           Int
  // Optional cap on a PERCENT discount (in minor units).
  maxDiscountMinor Int?
  // Minimum cart subtotal (in minor units) for the coupon to apply.
  minCartMinor    Int              @default(0)
  // Total redemptions allowed across all users. Null = unlimited.
  maxUses         Int?
  usedCount       Int              @default(0)
  // Per-user cap. Null = no cap.
  perUserLimit    Int?
  expiresAt       DateTime?
  startsAt        DateTime?
  active          Boolean          @default(true)
  // Optional applicability — if any rows exist, coupon ONLY applies to the
  // listed categories / concerns. If none, applies to whole cart.
  categories      CouponCategory[]
  concerns        CouponConcern[]
  redemptions     CouponRedemption[]
  orders          Order[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([active, expiresAt])
}

model CouponCategory {
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId   String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([couponId, categoryId])
}

model CouponConcern {
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId  String
  concern   Concern @relation(fields: [concernId], references: [id], onDelete: Cascade)
  concernId String

  @@id([couponId, concernId])
}

model CouponRedemption {
  id              String   @id @default(cuid())
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId        String
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String   @unique
  discountMinor   Int
  redeemedAt      DateTime @default(now())

  @@index([couponId, redeemedAt])
  @@index([userId, redeemedAt])
}

// ────────────────────────────────────────────────────────────────
// Shipments
// ────────────────────────────────────────────────────────────────

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  // FAILED kept for back-compat with rows already written under that status.
  FAILED
  LOST
  CANCELLED
}

model Shipment {
  id                String         @id @default(cuid())
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  courier           String
  trackingNumber    String?
  trackingUrl       String?
  status            ShipmentStatus @default(PENDING)
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  // Raw courier webhook payload — kept verbatim for forensic audits and
  // future replay if our parsing logic ever regresses.
  rawWebhook        Json?
  events            ShipmentEvent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orderId])
  @@index([status, updatedAt])
  @@index([trackingNumber])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId  String
  status      ShipmentStatus
  // Free-form courier-reported description (e.g. "Out for delivery, Mumbai hub").
  description String?
  occurredAt  DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

// ────────────────────────────────────────────────────────────────
// Reviews
// ────────────────────────────────────────────────────────────────

model Review {
  id               String   @id @default(cuid())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  user             User?    @relation(fields: [userId], references: [id])
  userId           String?
  authorName       String
  rating           Int
  title            String
  body             String   @db.Text
  verifiedPurchase Boolean  @default(false)
  approved         Boolean  @default(false)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([productId, approved])
  // Listing approved reviews by newest first hits this index instead of
  // a sort-on-disk after the [productId, approved] filter.
  @@index([productId, createdAt])
  @@index([deletedAt])
}

// ────────────────────────────────────────────────────────────────
// Storefront promotional content
// ────────────────────────────────────────────────────────────────

model OfferStripItem {
  id        String  @id @default(cuid())
  headline  String
  code      String?
  href      String  @default("/shop")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model HeroBanner {
  id        String   @id @default(cuid())
  eyebrow   String
  title     String
  subtitle  String
  ctaLabel  String
  ctaHref   String
  imageUrl  String
  accent    String?
  active    Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────
// Webhook event log
// ────────────────────────────────────────────────────────────────

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String   // "phonepe" | "resend" | "shipping" ...
  eventType       String?  // e.g. "payment.completed"
  // Idempotency key derived from the provider event id (or a hash of the
  // raw body when no event id is offered). Unique to guarantee at-most-once
  // processing on retries / replays.
  idempotencyKey  String   @unique
  // Verbatim signature header (e.g. PhonePe X-VERIFY). Kept for forensic
  // audits — never re-trusted after the initial verification step.
  signature       String?
  payload         Json
  processed       Boolean  @default(false)
  processedAt     DateTime?
  // Free-form failure detail when processing did not complete cleanly.
  error           String?
  createdAt       DateTime @default(now())

  @@index([provider, createdAt])
  @@index([processed, createdAt])
}
